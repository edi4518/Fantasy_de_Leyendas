# =============================================================================
# Fantasy de Leyendas PWA - Variables de Entorno (Backend)
# =============================================================================

# Entorno de ejecución (development | production)
APP_ENV=development

# Conexión a la base de datos MySQL (por defecto usuario 'root' y sin password en XAMPP)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/fantasy_leyendas

# Orígenes permitidos para peticiones Cross-Origin (Frontend LiveServer / React / Vite)
CORS_ORIGINS=["http://localhost:5500", "http://127.0.0.1:5500", "http://localhost:3000"]
