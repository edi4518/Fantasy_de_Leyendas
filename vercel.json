{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fantasy-de-leyendas-api.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://fantasy-de-leyendas-api.onrender.com/uploads/:path*"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/(onboarding|login|register|dashboard|matchmaking|market|comparison|lineup|history|ranking|profile)",
      "destination": "/public/index.html"
    },
    {
      "source": "/match/:path*",
      "destination": "/public/index.html"
    }
  ]
}
