{
  "headers": [
    {
      "source": "/(sw\\.js|public/sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(index\\.html|onboarding|login|register|dashboard|matchmaking|market|comparison|lineup|history|ranking|profile|admin)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/src/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|webp|svg|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/apple-touch-icon.png",
      "destination": "/public/icons/apple-touch-icon.png"
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "/public/icons/apple-touch-icon.png"
    },
    {
      "source": "/apple-touch-icon-180x180.png",
      "destination": "/public/icons/apple-touch-icon.png"
    },
    {
      "source": "/apple-touch-icon-180x180-precomposed.png",
      "destination": "/public/icons/apple-touch-icon.png"
    },
    {
      "source": "/sw.js",
      "destination": "/public/sw.js"
    },
    {
      "source": "/api/:path*",
      "destination": "https://fantasy-de-leyendas-api.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://fantasy-de-leyendas-api.onrender.com/uploads/:path*"
    },
    {
      "source": "/(onboarding|login|register|dashboard|matchmaking|market|comparison|lineup|history|ranking|profile|admin)",
      "destination": "/index.html"
    },
    {
      "source": "/match/:path*",
      "destination": "/index.html"
    }
  ]
}
