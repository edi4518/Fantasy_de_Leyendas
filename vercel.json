{
  "headers": [
    {
      "source": "/(index\\.html|onboarding|login|register|dashboard|matchmaking|market|comparison|lineup|history|ranking|profile|admin)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fantasy-de-leyendas-api.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://fantasy-de-leyendas-api.onrender.com/uploads/:path*"
    },
    {
      "source": "/(onboarding|login|register|dashboard|matchmaking|market|comparison|lineup|history|ranking|profile|admin)",
      "destination": "/index.html"
    },
    {
      "source": "/match/:path*",
      "destination": "/index.html"
    }
  ]
}
